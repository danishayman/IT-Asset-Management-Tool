@model ErrorViewModel
@{
    ViewData["Title"] = "Access denied";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm border-danger-subtle">
            <div class="card-body p-4 text-center">
                <i class="bi bi-shield-lock display-5 text-danger"></i>
                <h1 class="h4 mt-3">Access denied</h1>
                <p class="text-secondary">
                    Your account does not have rights to this page. If you believe it should,
                    ask an administrator to review your role.
                </p>
                <div class="d-flex gap-2 justify-content-center mb-3">
                    <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Home</a>
                    <a class="btn btn-primary" asp-controller="Assets" asp-action="Index">Browse assets</a>
                </div>
                <partial name="_CorrelationId" model="Model" />
            </div>
        </div>
    </div>
</div>
