@model ErrorViewModel
@{
    ViewData["Title"] = "Page not found";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body p-4 text-center">
                <i class="bi bi-compass display-5 text-secondary"></i>
                <h1 class="h4 mt-3">Page not found</h1>
                <p class="text-secondary">
                    That address does not match anything here. It may have been removed, or the
                    link may be mistyped.
                </p>
                <div class="d-flex gap-2 justify-content-center mb-3">
                    <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Home</a>
                    <a class="btn btn-primary" asp-controller="Assets" asp-action="Index">Browse assets</a>
                </div>
                <partial name="_CorrelationId" model="Model" />
            </div>
        </div>
    </div>
</div>
