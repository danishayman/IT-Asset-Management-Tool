@model TicketFormViewModel
@{
    ViewData["Title"] = "Raise a ticket";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index">Tickets</a></li>
        <li class="breadcrumb-item active" aria-current="page">New</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h5 mb-4">Raise a ticket</h1>

                <form asp-action="Create" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" placeholder="Laptop will not power on" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="6"
                                  placeholder="What happened, what you already tried, and when it started."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-5">
                            <label asp-for="Priority" class="form-label"></label>
                            <select asp-for="Priority" class="form-select"
                                    asp-items="@Html.GetEnumSelectList<TicketPriority>()"></select>
                            <span asp-validation-for="Priority" class="text-danger small"></span>
                        </div>

                        <div class="col-md-7">
                            <label asp-for="AssetId" class="form-label"></label>
                            <select asp-for="AssetId" class="form-select" asp-items="@Model.AssetOptions">
                                <option value="">Not about a specific asset</option>
                            </select>
                            <div class="form-text">Optional, but it helps IT find the machine faster.</div>
                            <span asp-validation-for="AssetId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-send me-1"></i> Submit ticket
                        </button>
                        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
