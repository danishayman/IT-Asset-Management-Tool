@using ItAssetManagement.Infrastructure
@model TicketDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
    var isAdmin = User.IsAdmin();

    // The badge partial takes a list item, so the details page borrows that shape rather
    // than duplicating the colour mapping.
    var badges = new TicketListItemViewModel { Status = Model.Status, Priority = Model.Priority };
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index">Tickets</a></li>
        <li class="breadcrumb-item active" aria-current="page">Ticket #@Model.Id</li>
    </ol>
</nav>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3">
                    <h1 class="h5 mb-0">@Model.Title</h1>
                    <div class="text-nowrap"><partial name="_TicketBadges" model="badges" /></div>
                </div>

                @* Preserves the line breaks the reporter typed without trusting their input
                   as markup: the content is still HTML-encoded by Razor. *@
                <p class="mb-0" style="white-space: pre-wrap;">@Model.Description</p>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h2 class="h6 text-secondary text-uppercase small mb-3">Ticket</h2>
                <dl class="row mb-0 small">
                    <dt class="col-5 fw-normal text-secondary">Raised by</dt>
                    <dd class="col-7">@Model.RaisedByFullName</dd>

                    <dt class="col-5 fw-normal text-secondary">Raised</dt>
                    <dd class="col-7">@Model.CreatedAt.ToLocalTime().ToString("d MMM yyyy HH:mm")</dd>

                    <dt class="col-5 fw-normal text-secondary">Asset</dt>
                    <dd class="col-7 mb-0">
                        @if (Model.AssetId is null)
                        {
                            <span class="text-secondary">Not linked</span>
                        }
                        else
                        {
                            <a asp-controller="Assets" asp-action="Details" asp-route-id="@Model.AssetId"
                               class="text-decoration-none">@Model.AssetTag</a>
                            <div class="text-secondary">@Model.AssetName</div>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        @if (isAdmin)
        {
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h6 text-secondary text-uppercase small mb-3">Change status</h2>
                    <div class="d-grid gap-2">
                        @foreach (var status in Enum.GetValues<TicketStatus>().Where(s => s != Model.Status))
                        {
                            <form asp-action="ChangeStatus" asp-route-id="@Model.Id" method="post">
                                <input type="hidden" name="status" value="@status" />
                                <button type="submit" class="btn btn-outline-secondary w-100">
                                    Move to @status.ToDisplayName()
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
