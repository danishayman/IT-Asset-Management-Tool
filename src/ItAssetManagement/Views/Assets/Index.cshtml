@using ItAssetManagement.Infrastructure
@model AssetListViewModel
@{
    ViewData["Title"] = "Assets";
    var isAdmin = User.IsAdmin();
    var results = Model.Results;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Assets</h1>
        <span class="text-secondary small">
            @if (results.TotalCount == 0)
            {
                <text>No assets match your filters.</text>
            }
            else
            {
                <text>Showing @results.FirstItemOnPage&ndash;@results.LastItemOnPage of @results.TotalCount</text>
            }
        </span>
    </div>

    <div class="d-flex gap-2">
        @* Carries the current filter, so the download matches what is on screen. *@
        <a class="btn btn-outline-success" asp-action="Export"
           asp-all-route-data="Model.Filter.ToRouteValues()">
            <i class="bi bi-file-earmark-excel me-1"></i> Export to Excel
        </a>

        @if (isAdmin)
        {
            <a class="btn btn-primary" asp-action="Create">
                <i class="bi bi-plus-lg me-1"></i> New asset
            </a>
        }
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body py-3">
        @* GET so that a filtered list is a shareable, bookmarkable URL. *@
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-5">
                <label asp-for="Filter.Search" class="form-label small mb-1">Search</label>
                <input asp-for="Filter.Search" class="form-control" placeholder="Name, asset tag or serial number" />
            </div>

            <div class="col-6 col-md-3">
                <label asp-for="Filter.Status" class="form-label small mb-1">Status</label>
                <select asp-for="Filter.Status" class="form-select"
                        asp-items="@Html.GetEnumSelectList<AssetStatus>()">
                    <option value="">All statuses</option>
                </select>
            </div>

            <div class="col-6 col-md-3">
                <label asp-for="Filter.CategoryId" class="form-label small mb-1">Category</label>
                <select asp-for="Filter.CategoryId" class="form-select" asp-items="@Model.CategoryOptions">
                    <option value="">All categories</option>
                </select>
            </div>

            <div class="col-12 col-md-1 d-grid">
                <button type="submit" class="btn btn-outline-secondary" title="Apply filters">
                    <i class="bi bi-search"></i>
                </button>
            </div>

            @if (Model.Filter.HasAnyFilter)
            {
                <div class="col-12">
                    <a asp-action="Index" class="small text-decoration-none">
                        <i class="bi bi-x-circle me-1"></i>Clear filters
                    </a>
                </div>
            }
        </form>
    </div>
</div>

@if (results.TotalCount == 0)
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5 text-secondary">
            <i class="bi bi-inbox display-6 d-block mb-2"></i>
            Nothing here. Try widening your search.
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Asset tag</th>
                        <th scope="col">Name</th>
                        <th scope="col">Category</th>
                        <th scope="col">Serial</th>
                        <th scope="col">Status</th>
                        <th scope="col">Assigned to</th>
                        <th scope="col">Location</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var asset in results.Items)
                    {
                        <tr>
                            <td class="text-nowrap-id fw-semibold">@asset.AssetTag</td>
                            <td>@asset.Name</td>
                            <td>@asset.CategoryName</td>
                            <td class="text-nowrap-id text-secondary small">@asset.SerialNumber</td>
                            <td><partial name="_StatusBadge" model="asset.Status" /></td>
                            <td>
                                @if (asset.AssignedToFullName is null)
                                {
                                    <span class="text-secondary">&mdash;</span>
                                }
                                else
                                {
                                    @asset.AssignedToFullName
                                }
                            </td>
                            <td class="text-secondary small">@asset.Location</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@asset.Id"
                                   title="View details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (isAdmin)
                                {
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@asset.Id"
                                       title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <partial name="_Pager" model="@(new PagerViewModel(results.Page, results.TotalPages, Model.Filter.ToRouteValues()))" />
}
