@using ItAssetManagement.Infrastructure
@model AssetDetailsViewModel
@{
    ViewData["Title"] = Model.AssetTag;
    var isAdmin = User.IsAdmin();
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index">Assets</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.AssetTag</li>
    </ol>
</nav>

<div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">@Model.Name</h1>
        <div class="text-secondary">
            <span class="text-nowrap-id">@Model.AssetTag</span>
            <span class="mx-1">&middot;</span>
            @Model.CategoryName
            <span class="ms-2"><partial name="_StatusBadge" model="Model.Status" /></span>
        </div>
    </div>

    @if (isAdmin)
    {
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                <i class="bi bi-trash me-1"></i> Delete
            </button>
        </div>
    }
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h6 text-secondary text-uppercase small mb-3">Details</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4 fw-normal text-secondary">Serial number</dt>
                    <dd class="col-sm-8 text-nowrap-id">@Model.SerialNumber</dd>

                    <dt class="col-sm-4 fw-normal text-secondary">Assigned to</dt>
                    <dd class="col-sm-8">
                        @if (Model.AssignedToFullName is null)
                        {
                            <span class="text-secondary">Nobody</span>
                        }
                        else
                        {
                            @Model.AssignedToFullName
                        }
                    </dd>

                    <dt class="col-sm-4 fw-normal text-secondary">Location</dt>
                    <dd class="col-sm-8">@Model.Location</dd>

                    <dt class="col-sm-4 fw-normal text-secondary">Purchase date</dt>
                    <dd class="col-sm-8">@Model.PurchaseDate.ToString("d MMM yyyy")</dd>

                    <dt class="col-sm-4 fw-normal text-secondary">Purchase cost</dt>
                    <dd class="col-sm-8">RM @Model.PurchaseCost.ToString("N2")</dd>

                    <dt class="col-sm-4 fw-normal text-secondary">Warranty expiry</dt>
                    <dd class="col-sm-8">
                        @Model.WarrantyExpiry.ToString("d MMM yyyy")
                        @if (Model.IsUnderWarranty)
                        {
                            <span class="badge text-bg-success-subtle text-success-emphasis ms-1">Under warranty</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary ms-1">Expired</span>
                        }
                    </dd>

                    <dt class="col-sm-4 fw-normal text-secondary">Added</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("d MMM yyyy HH:mm")</dd>

                    <dt class="col-sm-4 fw-normal text-secondary">Last updated</dt>
                    <dd class="col-sm-8 mb-0">@Model.UpdatedAt.ToLocalTime().ToString("d MMM yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        @if (isAdmin)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h2 class="h6 text-secondary text-uppercase small mb-3">Assignment</h2>

                    @if (Model.AssignedToUserId is null)
                    {
                        <form asp-action="Assign" asp-route-id="@Model.Id" method="post" class="row g-2">
                            <div class="col-12 col-sm-7">
                                <select name="assignedToUserId" class="form-select" required
                                        asp-items="@Model.AssignableUsers">
                                    <option value="">Choose a person</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-5 d-grid">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-person-check me-1"></i> Assign
                                </button>
                            </div>
                            <div class="col-12">
                                <div class="form-text">Assigning sets the status to In use.</div>
                            </div>
                        </form>
                    }
                    else
                    {
                        <p class="mb-3">
                            Currently held by <strong>@Model.AssignedToFullName</strong>.
                        </p>
                        <form asp-action="Unassign" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn btn-outline-secondary">
                                <i class="bi bi-person-dash me-1"></i> Return to pool
                            </button>
                            <div class="form-text">Returning sets the status back to Available.</div>
                        </form>
                    }
                </div>
            </div>
        }

        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h6 text-secondary text-uppercase small mb-3">Recent activity</h2>

                @if (Model.RecentActivity.Count == 0)
                {
                    <p class="text-secondary small mb-0">No activity recorded yet.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0 small">
                        @foreach (var entry in Model.RecentActivity)
                        {
                            <li class="d-flex gap-2 mb-3">
                                <span class="badge text-bg-light border align-self-start">@entry.Action</span>
                                <div>
                                    <div>@entry.Details</div>
                                    <div class="text-secondary">
                                        @entry.PerformedByFullName
                                        &middot; @entry.Timestamp.ToLocalTime().ToString("d MMM yyyy HH:mm")
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

@if (isAdmin)
{
    @* Deletion is irreversible, so it is gated behind an explicit confirmation that names
       the asset, and submitted as a POST with an antiforgery token. *@
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">Delete this asset?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">
                        <strong>@Model.AssetTag</strong> &mdash; @Model.Name
                    </p>
                    <p class="text-secondary small mb-0">
                        This cannot be undone. The activity history is kept and will show the
                        asset as deleted.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i> Delete asset
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
