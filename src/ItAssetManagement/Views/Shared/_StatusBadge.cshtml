@model AssetStatus
@{
    // Colour carries meaning here, so each badge also spells the status out in text.
    var css = Model switch
    {
        AssetStatus.InUse     => "text-bg-primary",
        AssetStatus.Available => "text-bg-success",
        AssetStatus.Repair    => "text-bg-warning",
        AssetStatus.Retired   => "text-bg-secondary",
        _                     => "text-bg-light"
    };
}
<span class="badge @css">@Model.ToDisplayName()</span>
