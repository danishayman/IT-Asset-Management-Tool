@model AssetStatus
@{
    // Colour carries meaning here, so each badge also spells the status out in text.
    var (css, label) = Model switch
    {
        AssetStatus.InUse     => ("text-bg-primary", "In use"),
        AssetStatus.Available => ("text-bg-success", "Available"),
        AssetStatus.Repair    => ("text-bg-warning", "Repair"),
        AssetStatus.Retired   => ("text-bg-secondary", "Retired"),
        _                     => ("text-bg-light", Model.ToString())
    };
}
<span class="badge @css">@label</span>
