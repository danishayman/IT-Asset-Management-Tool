@model UserFormViewModel

<form asp-action="@(Model.IsEdit ? "Edit" : "Create")" method="post" novalidate>
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Username" class="form-label"></label>
            <input asp-for="Username" class="form-control" autocomplete="off" />
            <span asp-validation-for="Username" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Role" class="form-label"></label>
            <select asp-for="Role" class="form-select" asp-items="@UserFormViewModel.RoleOptions"></select>
            <div class="form-text">Administrators can manage assets, users and the activity log.</div>
            <span asp-validation-for="Role" class="text-danger small"></span>
        </div>

        <div class="col-md-6 d-flex align-items-center">
            <div class="form-check mt-3">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
                <div class="form-text">Deactivated accounts keep their history but cannot sign in.</div>
            </div>
        </div>

        <div class="col-12"><hr class="my-1" /></div>

        <div class="col-md-6">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            @if (Model.IsEdit)
            {
                <div class="form-text">Leave blank to keep the current password.</div>
            }
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i> @(Model.IsEdit ? "Save changes" : "Create user")
        </button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>
